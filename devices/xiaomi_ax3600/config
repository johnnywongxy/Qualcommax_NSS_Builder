#
# Xiaomi AX3600 (IPQ8071A) with the 1 GB RAM mod — the reference build.
#
# Concatenated onto devices/common/config by prepare-build.sh.
#

CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

# 1 GB board (RAM mod): the ath11k profile is also forced by kmod-ath11k's
# NSS block, and the HIGH NSS profile is the ipq807x default, which now fits.
CONFIG_ATH11K_MEM_PROFILE_1G=y
CONFIG_NSS_MEM_PROFILE_HIGH=y

CONFIG_ATH10K-CT_LEDS=n
CONFIG_PACKAGE_ath10k-board-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=n

## Hardware this board does not have.
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-xhci-hcd=n
CONFIG_PACKAGE_kmod-usb3=n

## User extras (2026-10-01): proxy, KMS, UPnP, Lucky, Proton2025 theme.
## The theme is vendored into the openwrt fork (package/luci-theme-proton2025)
## because its repo root is the package itself, which a feed cannot scan;
## the other three come from the feeds added in .github/workflows/build.yml.
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-lucky=y
CONFIG_PACKAGE_luci-app-upnp=y

## Tools (2026-10-01): scp binary (ships as /usr/libexec/scp-openssh with an
## /usr/bin/scp alternative; the sftp-server is already in common), NAND
## rw access for partition surgery, and the usual benchmark set.
CONFIG_PACKAGE_openssh-client=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_coremark=y
# luci master enables language packs through the collection switch rather
# than per-package CONFIG_PACKAGE_luci-i18n-* selects (those get normalised
# away by defconfig); one line covers base + every app's zh-cn pack.
CONFIG_LUCI_LANG_zh_Hans=y

## ddnsto + KMS GUI (2026-10-02): luci-app-ddnsto (Lua UI, needs luci-compat)
## plus its ddnsto service package from the nas feed.
## KMS app + daemon are vendored from kenzok8/small-package; cpufreq from
## ivanxxxx/luci-app-cpufreq; ttyd from the official feeds.
CONFIG_PACKAGE_luci-app-ddnsto=y
CONFIG_PACKAGE_ddnsto=y
CONFIG_PACKAGE_luci-compat=y

## cpufreq + ttyd (2026-10-02): CPU frequency control (vendored, defaults to
## schedutil because the kernel ships no ondemand governor) and the web
## terminal (ttyd + luci-app-ttyd from the official feeds).
CONFIG_PACKAGE_luci-app-cpufreq=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ttyd=y

## coremark: enable multithreading so the score covers all four cores
## (default is single-threaded; threads default 2 when enabled).
CONFIG_COREMARK_ENABLE_MULTITHREADING=y
CONFIG_COREMARK_NUMBER_OF_THREADS=4

## KMS emulator (vendored in the source fork mainline).
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_luci-app-vlmcsd=y
## Proton2025 theme (vendored on the source fork mainline).
CONFIG_PACKAGE_luci-theme-proton2025=y

## Initramfs image for the one-time migration into the upstream
## partition layout (boot it from the bootloader, then sysupgrade).
CONFIG_TARGET_ROOTFS_INITRAMFS=y
